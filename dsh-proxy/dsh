#!/usr/bin/env bash

# Run the built dsh CLI from either this source checkout or a deployed app directory.
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ -f "$SCRIPT_DIR/lib/bin.js" ]]; then
  CLI_ENTRY="$SCRIPT_DIR/lib/bin.js"
elif [[ -f "$SCRIPT_DIR/node_modules/@deepseek-ai/dsh/lib/bin.js" ]]; then
  CLI_ENTRY="$SCRIPT_DIR/node_modules/@deepseek-ai/dsh/lib/bin.js"
elif [[ -f "$SCRIPT_DIR/../apps/cli/lib/bin.js" ]]; then
  CLI_ENTRY="$SCRIPT_DIR/../apps/cli/lib/bin.js"
else
  printf 'dsh: built CLI not found; run pnpm run build before deployment\n' >&2
  exit 1
fi

exec node "$CLI_ENTRY" "$@"
